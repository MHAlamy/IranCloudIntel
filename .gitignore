# Secrets and local configuration — never commit
.env
.env.*
!.env.example

# Virtual environment
.venv/
venv/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Databases and collected data — never commit production data
*.db
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
data/
backups/

# Source evidence and snapshots (may contain unsanitized pages)
evidence/
snapshots/

# Logs
logs/
*.log

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
