# Copy this file to .env and fill in real values. NEVER commit .env.
# Arvan AIaaS endpoint details must be verified in the Arvan console before use.

# Base URL of the Arvan AIaaS API (verify current value in Arvan docs/console)
AIaaS_BASE_URL=

# Model identifier to use for extraction (configurable; see PROJECT_GUIDE.md section 7)
AIaaS_MODEL=

# API key / token for Arvan AIaaS
AIaaS_API_KEY=
